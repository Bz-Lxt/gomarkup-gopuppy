# === GoPuppy runtime (copy to .env if you need overrides) ===
TZ=Asia/Shanghai
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080

# JWT
JWT_SECRET=gopuppy-dev-jwt-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# Database
DATABASE_URL=postgres://gopuppy:gopuppy@postgres:5432/gopuppy?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (explicit whitelist, never *)
CORS_ORIGINS=http://localhost:27151,http://127.0.0.1:27151

# Storage: local | oss | cos
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/uploads
# OSS (UNVERIFIED until real keys exist)
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# COS (UNVERIFIED until real keys exist)
COS_BUCKET_URL=
COS_SECRET_ID=
COS_SECRET_KEY=

# Notifiers
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=gopuppy@local.test
SMTP_USER=
SMTP_PASS=
# wecom | webhook real endpoints; empty => mock sink inside backend
WECOM_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
NOTIFIER_MODE=mock

# Reminder scheduler
REMINDER_SCAN_HOUR=8
REMINDER_TICK_SECONDS=30
